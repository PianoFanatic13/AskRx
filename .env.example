DATABASE_URL=postgresql://postgres:postgres@localhost:5432/asrx
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST
GROQ_API_KEY=your-groq-api-key-here
GOOGLE_API_KEY=your-google-ai-studio-api-key-here
LLM_BACKEND=gemini
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=askrx-dev

# API uses MemorySaver (in-process, per-worker) for conversation memory - run
# with `uvicorn backend.api.main:app --workers 1`, multiple workers would each
# get independent conversation state.
