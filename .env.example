DATABASE_URL=postgresql://postgres:postgres@localhost:5432/asrx
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST
GOOGLE_API_KEY=your-google-ai-studio-api-key-here
LLM_BACKEND=gemini
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=askrx-dev
OPENROUTER_API_KEY=your-openrouter-api-key-here
HF_KEY=your-huggingface-fine-grained-token-here

# API uses MemorySaver (in-process, per-worker) for conversation memory - run
# with `uvicorn backend.api.main:app --workers 1`, multiple workers would each
# get independent conversation state.

# HF_KEY must be a fine-grained token with "Make calls to Inference Providers"
# permission enabled - a plain read token gets a 403. Used only for query-time
# embedding (backend/retrieval/dense.py) via HF Inference Providers
# (hf-inference, BGE-large-en-v1.5). Ingestion (backend/embedding/embed.py)
# still runs the model locally and doesn't need this.
